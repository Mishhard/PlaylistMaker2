<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createPlaylistFragment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/settingsBackgroundColor">


<FrameLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
app:layout_constraintTop_toTopOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"


    >

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:layout_marginBottom="16dp"
    android:layout_marginTop="20dp"
    android:layout_marginLeft="20dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="@dimen/navigation_icon"
        android:layout_height="match_parent"
        android:layout_marginEnd="28dp"
        android:src="@drawable/back"
        android:maxLines="1"
        app:tint="?attr/primaryIconTint" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/new_playlist"
        android:textColor="?attr/primaryTextColor"
        style="@style/TextView" />
</LinearLayout>

</FrameLayout>
    <FrameLayout
        android:id="@+id/coverContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="82dp"
        android:background="@drawable/dashed_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1">

        <ImageView
            android:id="@+id/coverImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:clipToOutline="true"
            />
        <ImageView
            android:id="@+id/plusIcon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/add_playlist_cover" />
    </FrameLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/search_margin_top"
        android:layout_marginEnd="@dimen/search_margin_top"
        android:layout_marginTop="@dimen/search_margin_top"
        app:layout_constraintTop_toBottomOf="@+id/coverContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:boxStrokeWidth="1dp"
        app:boxCornerRadiusTopStart="@dimen/radius_search"
        app:boxCornerRadiusTopEnd="@dimen/radius_search"
        app:boxCornerRadiusBottomStart="@dimen/radius_search"
        app:boxCornerRadiusBottomEnd="@dimen/radius_search"
        app:boxStrokeColor="@color/stroke_input_color"
        app:hintTextColor="@color/hint_color"
        app:boxStrokeWidthFocused="2dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/playlist_title"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/descriptionInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/search_margin_top"
        android:layout_marginEnd="@dimen/search_margin_top"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/nameInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:boxStrokeWidth="1dp"
        app:boxCornerRadiusTopStart="@dimen/radius_search"
        app:boxCornerRadiusTopEnd="@dimen/radius_search"
        app:boxCornerRadiusBottomStart="@dimen/radius_search"
        app:boxCornerRadiusBottomEnd="@dimen/radius_search"
        app:boxStrokeColor="@color/stroke_input_color"
        app:hintTextColor="@color/hint_color"
        app:boxStrokeWidthFocused="2dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/descriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/playlist_description"
            android:inputType="textMultiLine"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/createButton"
        style="@style/BottomCreatePlaylist"

        app:layout_constraintTop_toBottomOf="@id/descriptionInputLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="17dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintVertical_bias="1.0"
        android:enabled="false"
        android:text="@string/create" />

</androidx.constraintlayout.widget.ConstraintLayout>
